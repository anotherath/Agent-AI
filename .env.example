# Copy to `.env` and fill real values. NEVER commit `.env`.

# ----- OpenAI (langchain ChatOpenAI) — https://platform.openai.com -----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                 # optional; OpenAI-compatible providers
OPENAI_TEMPERATURE=0.0
# OPENAI_TOP_P=1.0
# OPENAI_TOP_K=40

# ----- Tavily — https://tavily.com -----
TAVILY_API_KEY=tvly-your-key-here

# ----- CoinGecko — https://docs.coingecko.com -----
# Public/Demo: key optional. Demo/Pro key if you have one.
COINGECKO_API_KEY=
# demo (default) | pro
COINGECKO_ENVIRONMENT=demo

# ----- App / auth (Track 3 — fill when implementing) -----
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/agent_ai_rag
# JWT_SECRET=replace-with-long-random-string
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ----- Cloudflare R2 (documents) -----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# ----- Qdrant -----
