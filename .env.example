# Copy → `.env`. Do not commit `.env`.

# --- Chat LLM ---
# Catalog: config/llm_providers.yaml (provider / base_url / models / default_model).
# Key(s) — tên biến phải khớp api_key_env trong YAML.
OPENAI_API_KEY=
OPENAI_TEMPERATURE=0.0
# Ngân sách suy luận (route / plan / tool-LLM). Alias cũ: OPENAI_MAX_TOKENS.
# OPENAI_REASONING_MAX_TOKENS=1024
# Ngân sách câu trả lời cuối (node generate) — tách riêng.
# OPENAI_GENERATE_MAX_TOKENS=2048
# OPENAI_TOP_P=1.0
# OPENAI_TOP_K=40

# --- Jev (TypeSafe) ---
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.65
MAX_REVIEW_LOOPS=2
# Số lần retry khi tool_select chọn tên tool không hợp lệ (sau lần đầu).
TOOL_SELECT_MAX_RETRIES=1
# Số lần sửa mỗi bước lỗi (tên tool / args / $stepN) trong plan_execution.
PLANNER_MAX_RETRIES=1

# --- Tools / infra ---
TAVILY_API_KEY=
# Langfuse (optional; omit keys to disable tracing)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
# OTEL_SERVICE_NAME=agent-ai-rag
# Postgres (Supabase). Scheme: postgresql+psycopg2://
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# --- Auth / session / CORS ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/app
AUTH_ERROR_REDIRECT_URL=http://localhost:3000/app?auth_error=1
# OAUTH_TRANSACTION_TTL_MINUTES=10
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
